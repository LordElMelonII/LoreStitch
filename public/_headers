# Cloudflare Pages header rules.
# JS/CSS are content-hashed by the Angular build (outputHashing: all) and the
# fonts are static, so they can be cached for a year. index.html, ngsw.json,
# ngsw-worker.js and the manifest keep the platform default (max-age=0,
# must-revalidate) so service-worker update checks stay fresh.
/*.js
  Cache-Control: public, max-age=31536000, immutable
/*.css
  Cache-Control: public, max-age=31536000, immutable
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/icons/*
  Cache-Control: public, max-age=31536000, immutable
